# ─── 模型（解析供應商回信；不設定也能用，回信改由人判讀） ─────────────────
# anthropic：Claude 官方 API；openai_compatible：Azure OpenAI、vLLM、Ollama 等 OpenAI 相容端點
LLM_PROVIDER=anthropic
LLM_API_KEY=
# LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=claude-haiku-5-5

# ─── 自動偵測 ───────────────────────────────────────────────────────────
# 每隔幾分鐘查一次 USGS 即時地震；有供應商廠區達到「需要確認」（MMI 5）就自動開案並寄風險快報。0＝關閉
AUTO_DETECT_MINUTES=10

# ─── 密鑰（setup 腳本會自動產生） ─────────────────────────────────────────
POSTGRES_PASSWORD=
JWT_SECRET=
# 所有示範帳號共用的密碼
SEED_DEMO_PASSWORD=

# ─── 網路（連接埠避開常見預設值，可和其他服務同時跑） ───────────────
# 網頁 http://localhost:3400，假信箱 Mailpit http://localhost:8026
WEB_PORT=3400
WEB_BIND=127.0.0.1
API_PORT=8380
DB_PORT=5437
MAIL_UI_PORT=8026
MAIL_SMTP_PORT=1026
# 在主機上直接跑 API、測試或評測時才用得到；Docker 內會自動改成連 db 容器
DATABASE_URL=postgresql+psycopg://aftershock:CHANGE_ME@localhost:5437/aftershock
