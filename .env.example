# ─── 密鑰（setup 腳本會自動產生） ─────────────────────────────────────────
POSTGRES_PASSWORD=
# 在主機上直接跑 API 或測試時才用得到；Docker 內會自動改成連 db 容器
DATABASE_URL=postgresql+psycopg://aftershock:CHANGE_ME@localhost:5437/aftershock

# ─── 網路（和 hr360、plantsight 錯開，三個專案可以同時跑） ───────────────
DB_PORT=5437
WEB_PORT=3400
WEB_BIND=127.0.0.1
MAIL_UI_PORT=8026
MAIL_SMTP_PORT=1026

# ─── 登入 ───────────────────────────────────────────────────────────────
JWT_SECRET=
SEED_DEMO_PASSWORD=

# ─── 模型（解析供應商回信） ─────────────────────────────────────────────
# anthropic：Claude 官方 API；openai_compatible：Azure OpenAI、vLLM、Ollama 等
LLM_PROVIDER=anthropic
LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=claude-haiku-5-5
API_PORT=8380
